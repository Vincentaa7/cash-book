// Prisma Schema untuk Cash Book - Manajemen Keuangan Keluarga (Multi-Family SaaS)
// Provider: MySQL (kompatibel dengan TiDB Cloud)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Member {
  id            String   @id @default(uuid()) @db.Char(36)
  familyId      String   @default("1") @map("family_id") @db.Char(36)
  name          String   @db.VarChar(100)
  email         String?  @unique @db.VarChar(191)
  emailVerified Boolean  @default(true) @map("email_verified")
  role          String   @default("member") @db.VarChar(10) // 'superadmin', 'admin', atau 'member'
  avatarColor   String?  @map("avatar_color") @db.VarChar(20)
  pin           String   @db.VarChar(255) // hashed PIN / password
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relasi
  transactions         Transaction[]         @relation("MemberTransactions")
  budgets              MonthlyBudget[]       @relation("MemberBudgets")
  activityLogs         ActivityLog[]         @relation("MemberActivityLogs")
  personalTransactions PersonalTransaction[] @relation("MemberPersonalTx")
  personalBudgets      PersonalBudget[]      @relation("MemberPersonalBudgets")

  @@index([familyId])
  @@map("members")
}

model MonthlyBudget {
  id        String   @id @default(uuid()) @db.Char(36)
  familyId  String   @default("1") @map("family_id") @db.Char(36)
  month     Int      // 1-12
  year      Int
  amount    BigInt   // dalam Rupiah
  createdBy String?  @map("created_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  // Relasi
  creator Member? @relation("MemberBudgets", fields: [createdBy], references: [id])

  @@unique([familyId, month, year], name: "uq_month_year")
  @@index([familyId])
  @@map("monthly_budgets")
}

model Transaction {
  id              String    @id @default(uuid()) @db.Char(36)
  familyId        String    @default("1") @map("family_id") @db.Char(36)
  itemName        String    @map("item_name") @db.VarChar(255)
  amount          BigInt    // dalam Rupiah
  category        String    @db.VarChar(100)
  transactionDate DateTime  @map("transaction_date") @db.Date
  notes           String?   @db.Text
  memberId        String?   @map("member_id") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  editedById      String?   @map("edited_by_id") @db.Char(36)
  editedByName    String?   @map("edited_by_name") @db.VarChar(100)

  // Relasi
  member Member? @relation("MemberTransactions", fields: [memberId], references: [id])

  @@index([familyId])
  @@index([transactionDate])
  @@index([category])
  @@index([memberId])
  @@map("transactions")
}

model AppSettings {
  id                  String   @id @default("1") @db.Char(36)
  familyName          String   @default("Cash Book") @map("family_name") @db.VarChar(100)
  inviteCode          String?  @unique @map("invite_code") @db.VarChar(50)
  theme               String   @default("light") @db.VarChar(10)
  lastCarryOverMonth  String?  @map("last_carry_over_month") @db.VarChar(7)
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Tabel untuk menyimpan rekap bulanan setelah transaksi satuan dihapus (> 90 hari)
model MonthlySnapshot {
  id          String   @id @default(uuid()) @db.Char(36)
  familyId    String   @default("1") @map("family_id") @db.Char(36)
  month       Int      // 1-12
  year        Int
  category    String   @db.VarChar(100)
  totalAmount BigInt   @map("total_amount")  // total Rupiah bulan itu untuk kategori ini
  txCount     Int      @map("tx_count")       // jumlah transaksi yang diarsipkan
  archivedAt  DateTime @default(now()) @map("archived_at")

  @@unique([familyId, month, year, category], name: "uq_snapshot")
  @@index([familyId])
  @@map("monthly_snapshots")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Char(36)
  familyId    String   @default("1") @map("family_id") @db.Char(36)
  action      String   @db.VarChar(50)
  description String   @db.Text
  details     String?  @db.Text        // JSON string
  memberId    String?  @map("member_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")

  member Member? @relation("MemberActivityLogs", fields: [memberId], references: [id])

  @@index([familyId])
  @@index([memberId])
  @@map("activity_logs")
}

// Catatan pengeluaran/pemasukan pribadi per-anggota (tidak mempengaruhi kas keluarga)
model PersonalTransaction {
  id          String    @id @default(uuid()) @db.Char(36)
  memberId    String    @map("member_id") @db.Char(36)
  itemName    String    @map("item_name") @db.VarChar(255)
  amount      BigInt    // dalam Rupiah
  type        String    @default("expense") @db.VarChar(10) // 'expense' | 'income'
  category    String    @db.VarChar(100)
  date        DateTime  @db.Date
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  member Member @relation("MemberPersonalTx", fields: [memberId], references: [id])

  @@index([memberId])
  @@index([date])
  @@map("personal_transactions")
}

// Saldo utama / Kas pribadi yang dialokasikan per anggota per bulan
model PersonalBudget {
  id        String   @id @default(uuid()) @db.Char(36)
  memberId  String   @map("member_id") @db.Char(36)
  month     Int      // 1-12
  year      Int
  amount    BigInt   // Saldo utama pribadi (Rupiah)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member Member @relation("MemberPersonalBudgets", fields: [memberId], references: [id])

  @@unique([memberId, month, year], name: "uq_personal_budget")
  @@map("personal_budgets")
}

// Tabel sementara untuk verifikasi OTP Email pendaftaran Superadmin baru
model EmailVerification {
  id          String   @id @default(uuid()) @db.Char(36)
  email       String   @unique @db.VarChar(191)
  username    String   @db.VarChar(100)
  pinHash     String   @map("pin_hash") @db.VarChar(255)
  familyName  String   @map("family_name") @db.VarChar(100)
  avatarColor String?  @map("avatar_color") @db.VarChar(20)
  otpHash     String   @map("otp_hash") @db.VarChar(255)
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("email_verifications")
}
